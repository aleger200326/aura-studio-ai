# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://aura_user:aura_password@localhost:5432/aura_studio?schema=public"

# --- Google Gemini (Google AI Studio) — основной провайдер ---
# Ключ и выбор модели (3.5 / 3.6 / 3.8) также можно задать прямо в /admin -> AI-Агент (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-studio-key"
GEMINI_MODEL="gemini-3.8-flash" # Варианты: gemini-3.5-flash-lite | gemini-3.6-flash | gemini-3.8-flash

# --- OpenAI (опционально, если используется вместо Google) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Установите "true" для локального тестирования UI без API-ключа
AI_MOCK_MODE="false"

# --- Telegram Bot (Node.js / grammY) ---
TELEGRAM_BOT_TOKEN="1234567890:AAF_your_bot_token"
TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_ALLOWED_CHAT_IDS="-1001234567890"
TELEGRAM_WEBHOOK_SECRET="change-me-32-char-random-secret-key"

# --- Admin Panel ---
ADMIN_PASSWORD="aura-admin-2026"
ADMIN_JWT_SECRET="change-me-64-char-random-jwt-signing-secret-key-for-sessions"

# --- App Config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Tashkent"
